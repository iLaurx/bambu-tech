# Copy to .env.local. Leave actual credentials out of version control.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon JWT. Never a privileged key.
SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed for validated uploads, asset registration and authorized image delivery.
SUPABASE_SERVICE_ROLE_KEY=
